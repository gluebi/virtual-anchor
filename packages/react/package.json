{
  "name": "react-virtual-anchor",
  "version": "0.0.0",
  "description": "React virtual list with variable item heights, per-item viewport events and pixel-perfect scrollToKey. Scroll position is an anchor, not an offset.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "//": "Points at source so typecheck and vite dev need no prior build. pnpm rewrites these from publishConfig on publish.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "virtual-anchor": "workspace:*",
    "zustand": "^5.0.14"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "scrollyfills": "^1.0.4"
  },
  "peerDependenciesMeta": {
    "scrollyfills": {
      "optional": true
    }
  },
  "keywords": [
    "react",
    "virtual",
    "virtualization",
    "virtual-list",
    "windowing",
    "scroll-anchoring",
    "variable-height",
    "intersection"
  ]
}
