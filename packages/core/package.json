{
  "name": "virtual-anchor",
  "version": "0.0.0",
  "description": "Anchor-based virtual scrolling core: variable item sizes, per-item viewport events, pixel-perfect scroll-to-item. Framework-agnostic.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "//": "Points at source so typecheck and vite dev need no prior build. pnpm rewrites these from publishConfig on publish.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zustand": "^5.0.14"
  },
  "keywords": [
    "virtual",
    "virtualization",
    "virtual-list",
    "scroll",
    "scroll-anchoring",
    "variable-height"
  ]
}
